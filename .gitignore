# Keep the repository focused on reproduction code and textual experiment records.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README_reproduction.txt
!/REPORT.txt
!/AGENTS.md
!/scripts/
!/records/
!/gsle/
!/industrial_swap_v2/
!/reproduction_results.tar.gz.sha256
!/gsle_results.tar.gz.sha256

__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key
*.npz
*.npy
*.bin
*.pth
*.pt
*.ckpt
*.ply
*.safetensors
*.mp4
*.mov
*.avi
*.png
*.jpg
*.jpeg
*.zip
*.tar
*.tar.gz
*.7z

# Runtime readiness flags must be regenerated in each environment.
/records/*.completed
/records/*.reviewed
/records/*.verified
/records/gsle/*.completed
/records/gsle/current_status.json
*.pstats
/records/current_status.json

# Full logs and resource traces remain in the delivered results archive.
/records/runs/*/stdout.log
/records/runs/*/gpu.csv
/records/runs/*/host_load.jsonl
/records/runs/*/instance_selection.jsonl
